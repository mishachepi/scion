# Пример файла флота для scripts/fork/rollout.sh. Настоящий хранит оператор, путь к нему — в $SCION_FLEET_ENV.
# Пути на удалённых узлах — абсолютные (~ там не раскрывается).

# Хаб на Linux-хосте и брокер рядом с ним
HUB_URL=https://hub.example
HUB_SSH=user@hub-host.example
HUB_BIN=/opt/scion/bin                  # бинарь хаба, плагин telegram и бинарь брокера
HUB_BROKER_HOME=/home/user/broker-home  # HOME user-юнита scion-broker
INFRA_DIR=/path/to/infra                # каталог ansible с playbooks/infra/scion-hub-rebuild.yaml
ANSIBLE_KEY=./ansible_id_ed25519        # --private-key плейбука (относительно INFRA_DIR)

# Брокер на удалённом Mac
MAC_SSH=user@mac.example
MAC_BIN=/path/to/bin

# Брокер на этом Mac
LOCAL_BIN=/path/to/bin
LOCAL_LINUX_BIN=/path/to/bin-linux-arm64 # каталог runtimes.<имя>.binaries контейнерного рантайма
LOCAL_BROKER_PLIST=/path/to/broker.plist

BROKER_LABEL=example.scion.broker       # launchd-метка брокера на обоих Mac
