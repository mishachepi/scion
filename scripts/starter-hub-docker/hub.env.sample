# Public hostname that resolves to this server. A DNS A record for
# this name must already point at the server's public IP, and ports
# 80/443 must be reachable for Caddy to obtain a TLS cert.
HUB_DOMAIN=hub.example.com

# Email Caddy registers with Let's Encrypt for renewal notices.
CADDY_EMAIL=you@example.com

# HMAC key for signing web session cookies AND seeding signing-key
# persistence across restarts. 32+ random bytes.
# Generate with:  openssl rand -hex 32
# Rotating this value logs all web users out (they relogin; no data lost).
# Maps to the binary's --session-secret / SCION_SERVER_SESSION_SECRET.
SCION_SESSION_SECRET=replace-me-with-32-bytes-of-random-hex

# Optional: extra hostnames/IPs to serve TLS on. Comma-prefixed list
# appended to HUB_DOMAIN as additional Caddy site addresses. Useful
# for LAN testing (peers on the same network reaching the hub by IP)
# or for serving both a public and an internal name from one host.
# Empty by default. Browsers hitting an IP will see the cert for
# HUB_DOMAIN (because IP literals can't be sent as SNI per RFC 6066)
# and must accept the warning OR trust Caddy's internal CA.
# Example:
#   LAN_HOSTS=, 192.168.50.10, hub.lan
LAN_HOSTS=
